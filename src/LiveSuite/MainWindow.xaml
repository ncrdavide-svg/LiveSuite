<Window x:Class="LiveSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiveSuite"
        Title="LiveSuite" Width="860" SizeToContent="Height" MinWidth="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" Icon="Assets/LiveSuite.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="28,24,28,20">

        <!-- Header -->
        <DockPanel LastChildFill="False">
            <Image Source="Assets/LiveSuite.png" Width="56" Height="56" DockPanel.Dock="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel DockPanel.Dock="Left" Margin="16,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="LiveSuite" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Le app della suite LIVE, sempre all'ultima versione." Foreground="{StaticResource Dim}" FontSize="14"/>
            </StackPanel>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="⟳  Controlla aggiornamenti"
                    VerticalAlignment="Center" Click="Refresh_Click"/>
        </DockPanel>

        <!-- LiveSuite itself has a newer version -->
        <Border x:Name="SelfUpdateBanner" Visibility="Collapsed" Margin="0,18,0,0" CornerRadius="10" Padding="16,12"
                Background="#33FFB300" BorderBrush="{StaticResource Amber}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="SelfUpdateButton" DockPanel.Dock="Right" Style="{StaticResource GoBtn}" Content="Aggiorna LiveSuite"
                        Click="SelfUpdate_Click"/>
                <TextBlock x:Name="SelfUpdateText" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <!-- One card per app -->
        <ItemsControl x:Name="AppList" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:AppItem}">
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="18" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Icon}" Width="72" Height="72" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border x:Name="Badge" Margin="10,2,0,0" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                            Background="{StaticResource Neutral}">
                                        <TextBlock x:Name="BadgeText" Text="{Binding BadgeText}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Dim}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource Dim}" FontSize="13.5" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <TextBlock Text="{Binding InstalledText}" FontSize="13"/>
                                <TextBlock Text="{Binding LatestText}" FontSize="13" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>

                                <StackPanel Visibility="{Binding Busy, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                                 Foreground="{StaticResource Go}" Background="{StaticResource Neutral}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding BusyText}" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="170">
                                <Button x:Name="Primary" Style="{StaticResource Btn}" Content="{Binding PrimaryText}"
                                        IsEnabled="{Binding CanPrimary}" Click="Primary_Click"
                                        Visibility="{Binding ShowPrimary, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource Btn}" Content="Apri la versione attuale" Margin="0,8,0,0" FontWeight="Normal"
                                        Visibility="{Binding ShowOpenSecondary, Converter={StaticResource Vis}}" Click="Open_Click"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                            Visibility="{Binding ShowReleases, Converter={StaticResource Vis}}">
                                    <Button Style="{StaticResource LinkBtn}" Content="Novità" Click="Releases_Click"/>
                                    <TextBlock Text="  ·  " Foreground="{StaticResource Dim}" FontSize="13"
                                               Visibility="{Binding ShowReinstall, Converter={StaticResource Vis}}"/>
                                    <Button Style="{StaticResource LinkBtn}" Content="Reinstalla" Click="Reinstall_Click"
                                            Visibility="{Binding ShowReinstall, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding PrimaryIsDownload}" Value="True">
                            <Setter TargetName="Primary" Property="Style" Value="{StaticResource GoBtn}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="UpToDate">
                            <Setter TargetName="Badge" Property="Background" Value="#2622A046"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="#66DE80"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="ComingSoon">
                            <Setter TargetName="Badge" Property="Background" Value="#33FFB300"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Amber}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                            <Setter TargetName="Badge" Property="Background" Value="#33FFB300"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Amber}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer -->
        <DockPanel Margin="2,4,2,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="LiveSuite su GitHub" Click="SelfRepo_Click"/>
            <TextBlock DockPanel.Dock="Right" Text="  ·  " Foreground="{StaticResource Dim}" FontSize="13"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="☕ Offrimi un caffè" Click="Coffee_Click"/>
            <TextBlock x:Name="FooterText" Foreground="{StaticResource Dim}" FontSize="12.5"/>
        </DockPanel>
    </StackPanel>
</Window>
