<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 on purpose: it ships with every Windows 10/11, so LiveSuite is a single
       small .exe that needs no runtime and no installer (the apps it downloads bring their own). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LiveSuite</AssemblyName>
    <RootNamespace>LiveSuite</RootNamespace>
    <ApplicationIcon>Assets\LiveSuite.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>LiveSuite</Product>
    <Description>Scarica e aggiorna le app della suite LIVE</Description>
    <Copyright>LiveSuite</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\LiveSuite.ico" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8')">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
